{
  "name": "cratebot4",
  "version": "4.0.0",
  "description": "CrateBot4 - Audio tagging and vibe generation with improved reliability and performance",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": {
    "name": "CrateBot",
    "email": "support@cratebot.app"
  },
  "homepage": "https://github.com/your-org/cratebot",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/cratebot.git"
  },
  "scripts": {
    "dev": "vite",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --outfile=dist-electron/main.js --external:electron --external:electron-updater --format=esm --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\" && esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.js --external:electron --format=cjs",
    "build": "npm run build:electron && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build:electron && vite build && electron-builder",
    "electron:build:mac": "npm run build:electron && vite build && electron-builder --mac",
    "electron:build:mac:zip": "npm run build:electron && npx vite build && npx electron-builder --mac zip",
    "electron:build:win": "npm run build:electron && vite build && electron-builder --win",
    "electron:build:linux": "npm run build:electron && vite build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "publish": "electron-builder --publish always"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.0",
    "clsx": "^2.1.0",
    "electron-updater": "^6.7.3",
    "framer-motion": "^12.24.12",
    "lucide-react": "^0.312.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "wavesurfer.js": "^7.12.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.27.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.cratebot.app",
    "productName": "CrateBot",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "dist-electron/preload.js"
    ],
    "extraResources": [
      {
        "from": "resources/python/cratebot-server",
        "to": "cratebot-server"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "your-org",
      "repo": "cratebot",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 400
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons",
      "category": "Audio"
    }
  }
}
